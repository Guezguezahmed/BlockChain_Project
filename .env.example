# Copy to .env at the repo root (never commit .env).
# Used by Hardhat for Sepolia deploy + Etherscan verify.
# Local Hardhat tests do not need these values.

# Sepolia JSON-RPC endpoint (Infura, Alchemy, public RPC, etc.)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Deployer wallet private key (testnet only — never a mainnet key)
SEPOLIA_PRIVATE_KEY=

# Etherscan API key for hardhat-verify on Sepolia
ETHERSCAN_API_KEY=

# --- Flutter app (Phase 2) — pass via --dart-define, not necessarily this file ---
# After `npm run deploy:sepolia`, copy the printed ContractFactory address:
# FACTORY_ADDRESS=
# WALLETCONNECT_PROJECT_ID=   # from https://cloud.reown.com
# USE_MOCK=true               # default in app; set false for chain mode

# --- Backend (Phase 3; unused until then) ---
# RPC_URL=
# FACTORY_ADDRESS=
# START_BLOCK=
# MONGO_URI=
