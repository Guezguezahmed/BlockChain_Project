# Copy to .env at the repo root (never commit .env).
# Used by Hardhat for Sepolia deploy + Etherscan verify.
# Local Hardhat tests do not need these values.

# Sepolia JSON-RPC endpoint (Alchemy preferred; public RPC also works)
# Example Alchemy: https://eth-sepolia.g.alchemy.com/v2/<YOUR_ALCHEMY_KEY>
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Deployer wallet private key (testnet only — never a mainnet key)
SEPOLIA_PRIVATE_KEY=

# Etherscan API key for hardhat-verify on Sepolia
ETHERSCAN_API_KEY=

# --- Flutter app (Smart Deal marketplace) — pass via --dart-define ---
# Live Sepolia (public addresses — safe as examples):
# SDT_ADDRESS=0x6dBA1A76E8fAF697b8E4392b565021fd0038C0Ab
# NFT_ADDRESS=0x14D7811438c6638096BfefB029A22CBeAEF86F57
# MARKETPLACE_ADDRESS=0x910e480723a0Ed7bf7f22d5e01CcF8db2E2fA97B
# FACTORY_ADDRESS=0x0E847b5Dccd09e73199e3689fC4D0D25A0133F08
# ESCROW_IMPLEMENTATION=0x4bb80444D6669588F7bf1ed6b0EFE71B7Aacf25E
# USE_MOCK=false                 # required for on-chain marketplace / escrow
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/<YOUR_ALCHEMY_KEY>
#
# Reown Cloud project id (required when USE_MOCK=false):
#   1. Open https://cloud.reown.com and sign in
#   2. Create a project; copy the Project ID
#   3. --dart-define=WALLETCONNECT_PROJECT_ID=<your_reown_project_id>
# Do NOT invent or commit a real project id.
# WALLETCONNECT_PROJECT_ID=

# --- Backend (Phase 3; unused until then) ---
# RPC_URL=
# FACTORY_ADDRESS=
# START_BLOCK=
# MONGO_URI=
